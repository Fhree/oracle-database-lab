# config/.env.example plantilla. SI se versiona. NUNCA pongas aqui valores reales.
# Copia este archivo a config/.env y rellena contraseñas reales.
# Politica de Oracle: minimo 8 caracteres, con mayuscula, minuscula y numero.
# Evita los caracteres @ / y espacios: rompen la cadena de conexion usuario/clave@host.
ORACLE_PWD=change_me
APP_USER_PWD=change_me_too
